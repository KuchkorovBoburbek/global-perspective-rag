# Copy this file to .env and fill in your own key.
# NEVER commit the real .env file.

# --- OpenAI (used for BOTH chat/analysis AND embeddings) ---
# Your OpenAI API key goes here:
OPENAI_API_KEY=

# Chat model used for the comparison / Q&A / executive report chains.
# Do NOT hardcode this in application code — it is read from this env var so
# the model can be swapped without touching app logic. A safe default
# (gpt-4o-mini) is used only if this is left unset.
OPENAI_MODEL=gpt-5.6-luna

# Embedding model used to build the FAISS vector stores.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
